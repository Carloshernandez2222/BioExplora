# Clave de la API de Gemini para el asistente BioGuía IA (opcional).
# OJO: en un sitio estático la clave queda visible en el navegador.
# Restrínjala por dominio (HTTP referrer) en Google AI Studio / Google Cloud.
VITE_GEMINI_API_KEY=
# Modelo de Gemini (opcional)
VITE_GEMINI_MODEL=gemini-2.5-flash

# URL de la aplicación web de Google Apps Script para guardar la encuesta en Google Sheets (opcional).
# Ver google-sheets/INSTRUCCIONES.md
VITE_SHEETS_URL=
